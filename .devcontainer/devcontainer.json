{
  "name": "BEP-Catalysis Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installJupyterlab": true
    }
  },
  "postCreateCommand": "python -m venv /tmp/bep-uv && /tmp/bep-uv/bin/python -m pip install 'uv>=0.8,<1' && /tmp/bep-uv/bin/uv sync --locked --project notebooks/v3",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/notebooks/v3/.venv/bin/python"
      }
    }
  }
}
